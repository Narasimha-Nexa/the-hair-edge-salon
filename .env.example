# =============================================================================
# Hair Edge Unisex Salon - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Google Places API (New) - Server-side only
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Places API (New)
# Restrict: API restriction → Places API only
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------------------------------------
# Google Maps Embed API - Browser-side (public)
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Maps Embed API
# Restrict: HTTP referrer restriction → Add your domain (e.g., https://hairedgesalon.in/*)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# -----------------------------------------------------------------------------
# Google Place ID
# Find at: https://developers.google.com/maps/documentation/places/web-service/place-id
# Format: ChIJ... (already configured for Hair Edge Madhapur)
# -----------------------------------------------------------------------------
GOOGLE_PLACE_ID=ChIJVVVVKV6RyzsR82Zy8PIOmmA

# -----------------------------------------------------------------------------
# Optional: Analytics
# -----------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_ID=

# Plausible Analytics Domain (if using Plausible instead of GA)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# -----------------------------------------------------------------------------
# Optional: Site URL (for canonical URLs, sitemap)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://hairedgesalon.in

# -----------------------------------------------------------------------------
# Optional: WhatsApp Business API (if using official API instead of wa.me)
# -----------------------------------------------------------------------------
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=